+def _current_project_root(root_path: str) -> str:
+    """A Documents-default project whose folder is gone (a replaced Docker container) follows
+    UNSLOTH_STUDIO_PROJECTS_HOME; one whose folder exists stays put."""
+    if not (os.environ.get("UNSLOTH_STUDIO_PROJECTS_HOME") or "").strip():
+        return root_path
+    root = Path(root_path).expanduser()
+    legacy = documents_project_workspaces_root()
+    if root.parent not in (legacy, Path(os.path.realpath(legacy))) or os.path.lexists(root):
+        return root_path
+    return str(project_workspaces_root() / root.name)
+
